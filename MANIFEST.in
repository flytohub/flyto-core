include LICENSE
include README.md
include CHANGELOG.md
include pyproject.toml

recursive-include src *.py
recursive-include src *.yaml

# reverse.deobfuscate's Node.js sidecar worker source (not node_modules,
# which requires a separate `npm install` regardless of packaging).
include src/core/modules/atomic/reverse/deobfuscate_worker/package.json
include src/core/modules/atomic/reverse/deobfuscate_worker/package-lock.json
include src/core/modules/atomic/reverse/deobfuscate_worker/worker.mjs

# testing.visual.compare's deterministic TypeScript sidecar source and lock.
include src/core/modules/atomic/testing/visual_worker/package.json
include src/core/modules/atomic/testing/visual_worker/package-lock.json
include src/core/modules/atomic/testing/visual_worker/tsconfig.json
include src/core/modules/atomic/testing/visual_worker/src/worker.ts

recursive-include workflows *.yaml
