{
  "schema": "flyto.capability-contract.v1",
  "about": "Judge vectors for the absolute-target ops distance_to and angle_to (flyto-core 2.38.0). A host that re-implements judge must reproduce every verdict exactly: usable and reason as given, numbers equal as IEEE-754 doubles.",
  "cases": [
    {
      "name": "a reported success 0.63 short of the target is not arrival",
      "spec": {
        "kind": "arrival",
        "observe": "map_pose",
        "phases": [
          "after",
          "settled"
        ],
        "measure": {
          "op": "distance_to",
          "fields": [
            "x",
            "y"
          ],
          "frame": "map"
        },
        "expect": {
          "arguments": {
            "x": "x",
            "y": "y"
          }
        },
        "tolerance": {
          "absolute": 0.3
        }
      },
      "arguments": {
        "x": 1.196,
        "y": -0.005,
        "yaw_radians": 0.0028
      },
      "observations": {
        "after": {
          "frame": "map",
          "x": 0.566,
          "y": -0.005,
          "yaw": 0.0
        },
        "settled": {
          "frame": "map",
          "x": 0.566,
          "y": -0.005,
          "yaw": 0.0
        }
      },
      "verdict": {
        "usable": false,
        "measured": 0.63,
        "expected": 0.0,
        "allowed": 0.3,
        "settle_drift": null,
        "reason": "measured 0.63, expected 0, error 0.63 exceeds allowed 0.3"
      }
    },
